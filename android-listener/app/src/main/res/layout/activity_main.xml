<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/walz_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header brand -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_launcher_foreground" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.04"
                    android:text="WALZPAY"
                    android:textColor="@color/walz_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/walz_muted"
                    android:textSize="12sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Status card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Status sistem"
                android:textColor="@color/walz_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPermissionStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="Cek status izin..."
                android:textColor="@color/walz_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvBatteryStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="4dp"
                android:text="Cek baterai..."
                android:textColor="@color/walz_text"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/tvShizukuStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Shizuku: …"
                android:textColor="@color/walz_muted"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Permissions -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="8dp"
            android:text="Izin & optimasi"
            android:textColor="@color/walz_muted"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnOpenNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Izinkan akses notifikasi"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnBattery"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="2. Tanpa batasan baterai"
            android:textColor="@color/walz_text"
            app:cornerRadius="14dp"
            app:strokeColor="@color/walz_card_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAutostart"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="3. Autostart (Xiaomi/OPPO/Vivo/…)"
            android:textColor="@color/walz_text"
            app:cornerRadius="14dp"
            app:strokeColor="@color/walz_card_stroke" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShizuku"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="4. Izinkan Shizuku (opsional)"
            android:textColor="@color/walz_text"
            app:cornerRadius="14dp"
            app:strokeColor="@color/walz_card_stroke" />

        <!-- Connection card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="10dp"
                android:text="Koneksi website"
                android:textColor="@color/walz_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Webhook URL"
                android:textColor="@color/walz_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etWebhookUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="https://…vercel.app/api/webhook"
                android:inputType="textUri"
                android:padding="12dp"
                android:textColor="@color/walz_text"
                android:textColorHint="@color/walz_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="API Key (wajib · dari Setel website)"
                android:textColor="@color/walz_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:fontFamily="monospace"
                android:hint="API key merchant"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/walz_text"
                android:textColorHint="@color/walz_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Secret (opsional)"
                android:textColor="@color/walz_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/etSecret"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="WEBHOOK_SECRET"
                android:inputType="textPassword"
                android:padding="12dp"
                android:textColor="@color/walz_text"
                android:textColorHint="@color/walz_muted"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Sources -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPickPackages"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Pilih sumber notifikasi"
            android:textColor="@color/walz_text"
            app:cornerRadius="14dp"
            app:strokeColor="@color/walz_primary" />

        <TextView
            android:id="@+id/tvSelectedPackages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="6dp"
            android:paddingBottom="4dp"
            android:text="Default: DANA, GoPay, OVO, Shopee, WA…"
            android:textColor="@color/walz_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="12dp">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switchEnabled"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Aktifkan Listener"
                android:textColor="@color/walz_text" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="Simpan pengaturan"
            app:backgroundTint="@color/walz_primary"
            app:cornerRadius="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearLogs"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Bersihkan log"
            android:textColor="@color/walz_muted" />

        <!-- Logs -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingBottom="8dp"
                android:text="Log lokal"
                android:textColor="@color/walz_muted"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="Belum ada log"
                android:textColor="@color/walz_text"
                android:textSize="11sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
