<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WALZPAY Listener"
            android:textSize="22sp"
            android:textStyle="bold"
            android:paddingBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pantau notifikasi e-wallet → website (order jadi Sukses)"
            android:textSize="13sp"
            android:paddingBottom="12dp" />

        <TextView
            android:id="@+id/tvPermissionStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cek status izin..."
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvBatteryStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cek baterai..."
            android:paddingBottom="4dp" />

        <TextView
            android:id="@+id/tvShizukuStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Shizuku: …"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/btnOpenNotificationAccess"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="1. Izinkan akses notifikasi" />

        <Button
            android:id="@+id/btnBattery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="2. Tanpa batasan baterai"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnAutostart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="3. Autostart (Xiaomi/OPPO/Vivo/…)"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnShizuku"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="4. Izinkan Shizuku (opsional)"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Webhook URL"
            android:paddingTop="16dp" />

        <EditText
            android:id="@+id/etWebhookUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="https://DOMAIN-ANDA.vercel.app/api/webhook"
            android:inputType="textUri" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="API Key (wajib · salin dari Setel di website)"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/etApiKey"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="API key merchant"
            android:inputType="textPassword"
            android:fontFamily="monospace" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Secret (opsional · WEBHOOK_SECRET Vercel)"
            android:paddingTop="12dp" />

        <EditText
            android:id="@+id/etSecret"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Opsional"
            android:inputType="textPassword" />

        <Button
            android:id="@+id/btnPickPackages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Pilih sumber notifikasi"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/tvSelectedPackages"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Belum dipilih (default DANA dll)"
            android:textSize="12sp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="5. Aktifkan Listener"
            android:paddingTop="16dp" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simpan pengaturan"
            android:layout_marginTop="12dp" />

        <Button
            android:id="@+id/btnClearLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Bersihkan log"
            android:layout_marginTop="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="Log lokal"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLogs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="8dp"
            android:textSize="12sp"
            android:fontFamily="monospace"
            android:text="Belum ada log" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="20dp"
            android:text="Tips: aktifkan Autostart + tanpa optimasi baterai. Shizuku opsional (pasang app Shizuku + start via Wireless debugging)."
            android:textSize="12sp" />

    </LinearLayout>
</ScrollView>
