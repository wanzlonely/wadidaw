<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: only HTTPS, no cleartext -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Allow debug overrides only in debug builds if needed -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </debug-overrides>

    <!-- Pin to Vercel / our domains (loose pin for flexibility; tighten later with real pins) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">vercel.app</domain>
        <domain includeSubdomains="true">walzpaynew.vercel.app</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
