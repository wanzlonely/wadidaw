# Upstash Redis (wajib untuk produksi)
# Console: https://console.upstash.com → Create database → REST API
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxx

# Opsional: proteksi webhook dari HP
WEBHOOK_SECRET=ganti-dengan-string-rahasia

# OTP email via Gmail App Password (wajib jika mau kirim OTP)
# Buat di: Google Account → Security → 2-Step Verification → App passwords
# JANGAN commit nilai asli ke git — set hanya di Vercel Environment Variables
GMAIL_USER=
GMAIL_APP_PASSWORD=
